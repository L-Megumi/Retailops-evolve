      "clauses": [
        {
          "id": "retailops_metric_calculation",
          "title": "指标计算与结果职责",
          "text": "RetailOps通过TaskContract声明每日净销售额、退款率、品类排行等所需结果，以ToolResult.data保存工具计算结果。ExecutionPolicy默认退款率分母为去重订单数，品类退款按比例分配，退款按发生日期归属。具体金额和数量由结构化工具计算，知识说明负责解释口径。",
          "topics": [
            "指标",
            "退款率",
            "去重订单",
            "计算",
            "口径",
            "工具"
          ]
        },
        {
          "id": "retailops_raw_effective_views",
          "title": "原始与有效退款视图",
          "text": "RetailOps的raw视图读取原始退款记录；effective视图读取已选退款变换链处理后的记录。退款变换使用effective视图，指标插件通过input_view声明读取哪一种视图；effective指标在变换后执行。报告应注明使用的视图和变换链。",
          "topics": [
            "raw",
            "effective",
            "原始视图",
            "有效视图",
            "去重",
            "封顶",
            "口径"
          ]
        }
      ]
    },
