      "clauses": [
        {
          "id": "jd_marketplace_no_reason_shipping",
          "title": "七天无理由退货运费",
          "text": "签收后7天内，支持七天无理由退货的京东第三方商品：包邮订单由买家付退回运费；非包邮订单由买家付双向运费。",
          "topics": [
            "七天无理由",
            "包邮",
            "运费",
            "退货"
          ]
        },
        {
          "id": "jd_marketplace_nonbuyer_shipping",
          "title": "非买家原因退换货运费",
          "text": "签收后7天内，京东第三方商品因质量、物流损坏、缺件或描述不符退换货：包邮订单由卖家付退回运费；非包邮订单由卖家付双向运费。",
          "topics": [
            "质量问题",
            "物流损坏",
            "缺件",
            "退换货",
            "运费"
          ]
        }
      ]
    },
